# ============================================
# GITIGNORE ESTRICTO - SOLO ARCHIVOS DE CÓDIGO
# ============================================

# Ignora TODO por defecto
*

# ============================================
# EXCEPCIONES: Solo estos archivos se subirán
# ============================================

# Archivos de Python
!*.py
!*.pyw

# Archivos de C#
!*.cs

# Archivos de JavaScript/TypeScript
!*.js
!*.jsx
!*.ts
!*.tsx

# Archivos de Java
!*.java

# Archivos de C/C++
!*.cpp
!*.cc
!*.cxx
!*.c
!*.hpp
!*.hh
!*.hxx
!*.h

# ============================================
# ARCHIVOS DE CONFIGURACIÓN ESENCIALES
# ============================================

# Archivo gitignore (obligatorio)
!.gitignore

# Documentación básica
!README.md
!README.txt
!README
!LICENSE.md
!LICENSE.txt
!LICENSE
!COPYING

# Archivos de configuración de proyectos
!package.json      # Node.js
!requirements.txt  # Python
!pom.xml           # Java Maven
!build.gradle      # Java Gradle
!*.csproj          # C# project
!*.sln             # C# solution
!CMakeLists.txt    # C/C++
!Makefile

# ============================================
# CARPETAS (necesario para acceder a archivos)
# ============================================

# Permite todas las carpetas
!*/

# ============================================
# EXCLUSIONES ESPECÍFICAS DENTRO DE CARPETAS
# ============================================

# Excluye carpetas de dependencias y builds
node_modules/
__pycache__/
.vs/
.vscode/
.idea/
bin/
obj/
dist/
build/
out/
target/
*.egg-info/

# Excluye archivos dentro de carpetas permitidas que no sean de código
**/*.dll
**/*.pdb
**/*.exe
**/*.class
**/*.pyc
**/*.pyo
*.so
*.a
*.lib
*.dylib